# Copy this file to `.env.local` and fill in the values.

# The Web app URL you get after deploying google-apps-script/Code.gs
# (looks like https://script.google.com/macros/s/AKfyc.../exec)
APPS_SCRIPT_URL=

# Any long random string. It MUST match the UPLOAD_TOKEN Script Property
# you set in the Apps Script project. Acts as a shared password so only
# this app can upload to your Drive folder.
UPLOAD_TOKEN=
